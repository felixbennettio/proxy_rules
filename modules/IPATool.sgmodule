[Script]
App_Store_API = type=http-request,pattern=^https:\/\/apple-api\.com,script-path=https://git.routeforge.zone/api/v4/projects/13/repository/files/modules%2Fscripts%2F691372cf8af55ba2-AppStoreAPI.js/raw?ref=main&private_token={{{GitLabToken}}},requires-body=true
script = type=http-request,pattern=^https:\/\/xiaobai\.app,script-path=https://git.routeforge.zone/api/v4/projects/13/repository/files/modules%2Fscripts%2F9f16fcadb82d6ca6-Installer.js/raw?ref=main&private_token={{{GitLabToken}}}

[MITM]
hostname = %APPEND% apple-api.com, xiaobai.app

#!name=Script-Hub
#!arguments=GitLabToken:""
#!desc=将其他工具的Rewrite、Rule和JavaScript资源转换为Loon能识别的格式，使用前请在本插件的详情页面为[PROXY]项分配代理策略。在插件列表中点击此插件上的链接查看使用方法。
#!category=资源转换
# Converted sources: Script-Hub
# Generated by scripts/loon2surge.py

[Rule]
DOMAIN,scripthub.vercel.app,DIRECT

[Script]
script = type=http-request,pattern=^https?:\/\/script\.hub\/($|edit\/|reload),script-path=https://git.routeforge.zone/api/v4/projects/13/repository/files/modules%2Fscripts%2F71d45f38fd72e70b-script-hub.js/raw?ref=main&private_token={{{GitLabToken}}},timeout=300
Rewrite = type=http-request,pattern=^https?:\/\/script\.hub\/file\/_start_\/.+type=(?:qx-rewrite|surge-module|loon-plugin|all-module),script-path=https://git.routeforge.zone/api/v4/projects/13/repository/files/modules%2Fscripts%2Fd1171e6520deae64-Rewrite-Parser.js/raw?ref=main&private_token={{{GitLabToken}}},timeout=300
Rule = type=http-request,pattern=^https?:\/\/script\.hub\/file\/_start_\/.+type=rule-set,script-path=https://git.routeforge.zone/api/v4/projects/13/repository/files/modules%2Fscripts%2F5f575b117bdf0130-rule-parser.js/raw?ref=main&private_token={{{GitLabToken}}},timeout=300
JavaScript = type=http-request,pattern=^https?:\/\/script\.hub\/convert\/,script-path=https://git.routeforge.zone/api/v4/projects/13/repository/files/modules%2Fscripts%2F884e36ed7bfefa03-script-converter.js/raw?ref=main&private_token={{{GitLabToken}}},timeout=300

[MITM]
hostname = %APPEND% script.hub, *.script.hub
